/*
 * Witly connect flow — styles for the "connect a chat app" wizard (rendered
 * inside an Element module dialog) and the persistent room-list CTA.
 *
 * Reads `--witly-*` (brand) and `--cpd-*` (Compound) tokens only; no hardcoded
 * brand values. Reuses `.witly_Btn` from onboarding.pcss (always bundled).
 */

/* ── Dialog wrapper ─────────────────────────────────────────────────────── */

.witly_Connect {
    /* Element's BaseDialog supplies the title bar + padding + max width. */
    min-width: 320px;
}

.witly_Connect_step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 0 8px;
}

.witly_Connect_step--centered {
    align-items: center;
    text-align: center;
}

.witly_Connect_title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    color: var(--cpd-color-text-primary);
}

.witly_Connect_subtitle {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
    color: var(--cpd-color-text-secondary);
}

/* ── Platform picker ────────────────────────────────────────────────────── */

.witly_Connect_platforms {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.witly_Connect_platform {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-canvas-default);
    cursor: pointer;
    text-align: left;
    transition:
        border-color var(--witly-motion-fast) var(--witly-ease-standard),
        background var(--witly-motion-fast) var(--witly-ease-standard),
        box-shadow var(--witly-motion-fast) var(--witly-ease-standard),
        transform var(--witly-motion-fast) var(--witly-ease-standard);
}

/* Enabled platforms read as tappable: subtle elevation + solid surface. */
.witly_Connect_platform:not(.witly_Connect_platform--soon) {
    box-shadow: var(--witly-shadow-card);
}

.witly_Connect_platform:not(:disabled):hover {
    border-color: var(--witly-accent);
    background: var(--witly-accent-subtle);
}

.witly_Connect_platform:not(:disabled):active {
    transform: scale(0.99);
}

/* Coming-soon platforms read as inert: flatter, greyed, no elevation. */
.witly_Connect_platform--soon {
    cursor: default;
    opacity: 0.55;
    box-shadow: none;
    background: var(--cpd-color-bg-subtle-secondary);
    border-style: dashed;
    filter: grayscale(0.35);
}

.witly_Connect_platform_glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex: 0 0 auto;
}

.witly_Connect_platform_body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
}

.witly_Connect_platform_name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
}

.witly_Connect_platform_blurb {
    font-size: 0.9rem;
    color: var(--cpd-color-text-secondary);
}

.witly_Connect_platform_go {
    flex: 0 0 auto;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: var(--witly-radius-pill);
    background: var(--witly-accent);
    color: var(--witly-on-accent);
}

.witly_Connect_platform:not(:disabled):hover .witly_Connect_platform_go {
    background: var(--witly-accent-hover);
}

.witly_Connect_platform_badge {
    flex: 0 0 auto;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 3px 8px;
    border-radius: var(--witly-radius-pill);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);
}

/* Already-linked platforms read as done: the whole card sits on a success
 * tint, the status reads "Connected", and the only action is to disconnect.
 * The card stacks vertically so the disconnect confirmation can expand into a
 * footer beneath the platform row rather than crowding it. */
.witly_Connect_platform--connected {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    border-color: var(--cpd-color-border-accent-primary);
    box-shadow: var(--witly-shadow-card);
    cursor: default;
}

/* The platform row (icon + name/status + disconnect) inside a connected card. */
.witly_Connect_platform_row {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-width: 0;
}

.witly_Connect_platform_status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cpd-color-text-success-primary);
}

.witly_Connect_platform_status svg {
    flex: 0 0 auto;
}

/* Secondary "Disconnect" action shown on a connected card. */
.witly_Connect_platform_disconnect {
    flex: 0 0 auto;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: var(--witly-radius-pill);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-critical-primary);
    cursor: pointer;
    transition:
        background var(--witly-motion-fast) var(--witly-ease-standard),
        border-color var(--witly-motion-fast) var(--witly-ease-standard);
}

.witly_Connect_platform_disconnect:hover {
    border-color: var(--cpd-color-border-critical-primary);
    background: var(--cpd-color-bg-critical-subtle);
}

/* Confirmation footer: appears at the bottom of a connected card when the user
 * taps Disconnect, explaining the consequences before they commit. */
.witly_Connect_platform_confirm {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--cpd-color-border-interactive-secondary);
}

.witly_Connect_platform_confirm_note {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--cpd-color-text-secondary);
}

.witly_Connect_platform_confirm_actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
}

.witly_Connect_platform_confirm_cancel,
.witly_Connect_platform_confirm_yes {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--witly-radius-pill);
    cursor: pointer;
    border: 1px solid transparent;
    transition:
        background var(--witly-motion-fast) var(--witly-ease-standard),
        border-color var(--witly-motion-fast) var(--witly-ease-standard);
}

.witly_Connect_platform_confirm_cancel {
    border-color: var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
}

.witly_Connect_platform_confirm_cancel:hover {
    background: var(--cpd-color-bg-subtle-secondary);
}

.witly_Connect_platform_confirm_yes {
    background: var(--cpd-color-bg-critical-primary);
    color: var(--cpd-color-text-on-solid-primary);
}

.witly_Connect_platform_confirm_yes:hover {
    background: var(--cpd-color-bg-critical-hovered);
}

/* Busy state while the disconnect request is in flight. */
.witly_Connect_platform_disconnecting {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cpd-color-text-secondary);
}

/* ── Illustration slot ──────────────────────────────────────────────────── */

.witly_Connect_illo {
    width: 100%;
    max-width: 260px;
    aspect-ratio: 16 / 9;
    border-radius: var(--witly-radius-md);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.witly_Connect_illo--placeholder {
    background:
        radial-gradient(120% 120% at 50% 0%, var(--witly-accent-subtle) 0%, transparent 70%),
        var(--cpd-color-bg-subtle-secondary);
    border: 1px dashed var(--cpd-color-border-interactive-secondary);
}

.witly_Connect_illo_media {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.witly_Connect_illo_glyph {
    font-size: 2.6rem;
    line-height: 1;
}

/* ── Pairing code ───────────────────────────────────────────────────────── */

.witly_Connect_code {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: 18px 16px;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--witly-accent);
    background: var(--witly-accent-subtle);
    cursor: pointer;
    transition: background var(--witly-motion-fast) var(--witly-ease-standard);
}

.witly_Connect_code:hover {
    background: var(--witly-accent-subtle-hover);
}

.witly_Connect_code_value {
    font-family: monospace;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    /* letter-spacing adds trailing space; nudge back so it looks centred. */
    text-indent: 0.28em;
    color: var(--cpd-color-text-primary);
}

.witly_Connect_code_hint {
    font-size: 0.88rem;
    color: var(--cpd-color-text-secondary);
}

/* ── Waiting / spinner / errors ────────────────────────────── */

.witly_Connect_waiting {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 0.98rem;
    color: var(--cpd-color-text-secondary);
}

.witly_Connect_waiting--subtle {
    font-size: 0.9rem;
}

.witly_Connect_spinner {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2.5px solid var(--witly-accent-subtle);
    border-top-color: var(--witly-accent);
    animation: witly_connect_spin 0.8s linear infinite;
    flex: 0 0 auto;
}

.witly_Connect_spinner--sm {
    width: 16px;
    height: 16px;
    border-width: 2px;
}

@keyframes witly_connect_spin {
    to {
        transform: rotate(360deg);
    }
}

.witly_Connect_error {
    font-size: 0.94rem;
    line-height: 1.4;
    margin: 0;
    padding: 10px 12px;
    border-radius: var(--witly-radius-sm);
    color: var(--cpd-color-text-critical-primary);
    background: var(--cpd-color-bg-critical-subtle);
}

.witly_Connect_link {
    align-self: center;
    background: none;
    border: none;
    padding: 4px;
    font-size: 0.92rem;
    color: var(--cpd-color-text-secondary);
    text-decoration: underline;
    cursor: pointer;
}

.witly_Connect_link--lg {
    font-size: 1rem;
    font-weight: 600;
    padding: 8px 4px;
}

.witly_Connect_link:hover {
    color: var(--cpd-color-text-primary);
}

/* ── "Didn't get a notification?" help disclosure ──────────────────── */

.witly_Connect_help {
    width: 100%;
    text-align: left;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-subtle-secondary);
}

.witly_Connect_help_summary {
    list-style: none;
    cursor: pointer;
    padding: 12px 14px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
}

.witly_Connect_help_summary::-webkit-details-marker {
    display: none;
}

.witly_Connect_help_summary::after {
    content: "›";
    float: right;
    color: var(--cpd-color-text-secondary);
    transition: transform var(--witly-motion-fast) var(--witly-ease-standard);
}

.witly_Connect_help[open] .witly_Connect_help_summary::after {
    transform: rotate(90deg);
}

.witly_Connect_help_body {
    padding: 0 14px 12px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--cpd-color-text-secondary);
}

.witly_Connect_help_body p {
    margin: 0 0 6px;
}

.witly_Connect_help_steps {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

/* ── Phone input ────────────────────────────────────────────────────────── */

.witly_PhoneInput {
    position: relative;
    display: flex;
    gap: 8px;
    width: 100%;
}

.witly_PhoneInput_country {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    height: 46px;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--cpd-color-border-interactive-primary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    cursor: pointer;
    flex: 0 0 auto;
    font-size: 0.95rem;
}

.witly_PhoneInput_country:disabled {
    opacity: 0.55;
    cursor: default;
}

.witly_PhoneInput_flag {
    font-size: 1.15rem;
    line-height: 1;
}

.witly_PhoneInput_dial {
    font-variant-numeric: tabular-nums;
}

.witly_PhoneInput_caret {
    font-size: 0.7rem;
    color: var(--cpd-color-text-secondary);
}

.witly_PhoneInput_number {
    flex: 1 1 auto;
    min-width: 0;
    height: 46px;
    padding: 0 14px;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--cpd-color-border-interactive-primary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    font-size: 0.98rem;
}

.witly_PhoneInput_number:focus {
    outline: none;
    border-color: var(--witly-accent);
    box-shadow: var(--witly-glow-accent);
}

.witly_PhoneInput_menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 10;
    width: min(340px, 100%);
    max-height: 280px;
    display: flex;
    flex-direction: column;
    border-radius: var(--witly-radius-md);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-canvas-default);
    box-shadow: var(--witly-shadow-card);
    overflow: hidden;
}

.witly_PhoneInput_search {
    padding: 8px;
    border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
}

.witly_PhoneInput_search input {
    width: 100%;
    height: 36px;
    padding: 0 10px;
    border-radius: var(--witly-radius-sm);
    border: 1px solid var(--cpd-color-border-interactive-primary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    font-size: 0.9rem;
}

.witly_PhoneInput_list {
    list-style: none;
    margin: 0;
    padding: 4px;
    overflow-y: auto;
}

.witly_PhoneInput_option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-radius: var(--witly-radius-sm);
    background: none;
    color: var(--cpd-color-text-primary);
    cursor: pointer;
    text-align: left;
    font-size: 0.9rem;
}

.witly_PhoneInput_option:hover,
.witly_PhoneInput_option[aria-selected="true"] {
    background: var(--witly-accent-subtle);
}

.witly_PhoneInput_name {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.witly_PhoneInput_option .witly_PhoneInput_dial {
    color: var(--cpd-color-text-secondary);
    flex: 0 0 auto;
}

.witly_PhoneInput_empty {
    padding: 12px;
    text-align: center;
    color: var(--cpd-color-text-secondary);
    font-size: 0.88rem;
}

/* ── Space-panel launcher (the "@" button) ──────────────────────────────── */

/* The icon container (`.mx_SpaceButton_icon`) already supplies the rounded
 * tile + padding; tint the WHOLE tile (not just an inner square) and colour the
 * glyph with the Witly accent so the launcher reads as a Witly surface. */
.witly_ConnectSpaceButton .mx_SpaceButton_icon {
    background-color: var(--witly-accent-subtle);
}

.witly_ConnectSpaceButton:hover .mx_SpaceButton_icon {
    background-color: var(--witly-accent-subtle-hover);
}

.witly_ConnectSpaceButton .mx_SpaceButton_icon svg {
    color: var(--witly-accent);
}

/* ── Room-list CTA ──────────────────────────────────────────────────────── */

.witly_ConnectCta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 8px 12px;
    padding: 12px 14px;
    border-radius: var(--witly-radius-md);
    background:
        radial-gradient(120% 120% at 0% 0%, var(--witly-accent-subtle) 0%, transparent 70%),
        var(--cpd-color-bg-subtle-secondary);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
}

.witly_ConnectCta_close {
    position: absolute;
    top: 4px;
    right: 6px;
    width: 20px;
    height: 20px;
    line-height: 18px;
    text-align: center;
    border: none;
    background: none;
    color: var(--cpd-color-text-secondary);
    font-size: 1.1rem;
    cursor: pointer;
    border-radius: var(--witly-radius-pill);
}

.witly_ConnectCta_close:hover {
    background: var(--cpd-color-bg-subtle-primary);
    color: var(--cpd-color-text-primary);
}

.witly_ConnectCta_glyph {
    font-size: 1.4rem;
    line-height: 1;
    flex: 0 0 auto;
}

.witly_ConnectCta_body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
}

.witly_ConnectCta_title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cpd-color-text-primary);
}

.witly_ConnectCta_text {
    font-size: 0.8rem;
    color: var(--cpd-color-text-secondary);
}

.witly_ConnectCta_action {
    flex: 0 0 auto;
    padding: 7px 14px;
    border-radius: var(--witly-radius-pill);
    border: none;
    background: var(--witly-accent-gradient);
    color: var(--witly-on-accent);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: box-shadow var(--witly-motion-fast) var(--witly-ease-standard);
}

.witly_ConnectCta_action:hover {
    box-shadow: var(--witly-glow-accent);
}
