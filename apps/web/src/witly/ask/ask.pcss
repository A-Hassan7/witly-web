/* AskAiTab — free-form agent surface inside the Witly panel. */

.witly_Ask {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
    height: 100%;
}

.witly_Ask_chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.witly_Ask_chip {
    font-size: 0.8125rem;
    padding: 6px 12px;
    border-radius: 999px;
}

.witly_Ask_thread {
    flex: 1 1 auto;
    min-height: 160px;
    max-height: 48vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 4px;
}

.witly_Ask_empty {
    color: var(--cpd-color-text-secondary);
    font-size: 0.875rem;
    text-align: center;
    margin: auto;
    max-width: 32ch;
}

.witly_Ask_turn {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 92%;
}

.witly_Ask_turn--user {
    align-self: flex-end;
    align-items: flex-end;
}

.witly_Ask_turn--assistant {
    align-self: flex-start;
    align-items: flex-start;
}

.witly_Ask_bubble {
    padding: 8px 12px;
    border-radius: 14px;
    font-size: 0.9375rem;
    line-height: 1.4;
    white-space: pre-wrap;
    word-break: break-word;
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
}

.witly_Ask_turn--user .witly_Ask_bubble {
    background: var(--witly-accent-subtle);
}

.witly_Ask_turn--error .witly_Ask_bubble {
    background: var(--cpd-color-bg-critical-subtle);
    color: var(--cpd-color-text-critical-primary);
}

.witly_Ask_typing {
    color: var(--cpd-color-text-secondary);
    font-style: italic;
}

.witly_Ask_actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.witly_Ask_action {
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 8px;
}

.witly_Ask_composer {
    display: flex;
    gap: 8px;
    align-items: center;
}

.witly_Ask_input {
    flex: 1 1 auto;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    font-size: 0.9375rem;
}

.witly_Ask_send {
    flex: 0 0 auto;
}
